# ==============================================================================
# ☕ Spring Boot 서비스 런타임 환경 설정 (application.env)
# ==============================================================================
# 이 파일은 Java / Spring Boot 애플리케이션 실행 옵션을
# 스크립트(start.sh) 수정 없이 동적으로 주입하기 위해 사용됩니다.
#
# [프로젝트 소스 내 위치 안내 (빌드/패키징 시 자동 오버레이)]
# - config.profiles/{profile}/application-{profile}.env (또는 application.env)
#
# [배포 패키지 내 위치]
# - config/application.env (컨테이너 내부 /app/config/application.env 로 마운트)
# ==============================================================================

# ------------------------------------------------------------------------------
# ☕ 1. JVM 힙 메모리 및 실행 옵션
# ------------------------------------------------------------------------------
# 초기 힙 메모리 (기본값: -Xms1024m)
JVM_XMS="-Xms1024m"

# 최대 힙 메모리 (기본값: -Xmx2048m)
JVM_XMX="-Xmx2048m"

# 추가 JVM 옵션 (GC 튜닝, 인코딩, 타임존 등)
EXTRA_JAVA_OPTS="-XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul"

# ------------------------------------------------------------------------------
# 🍃 2. Spring Boot 애플리케이션 파라미터 (Program Arguments)
# ------------------------------------------------------------------------------
# java -jar ... "$JAR_FILE" 뒤에 전달될 프로그램 인수 (공백으로 구분)
# 예시:
#   --server.port=8080
#   --spring.profiles.active=prod
#   --logging.level.root=INFO
#   --custom.feature.enabled=true
APP_ARGS=""
