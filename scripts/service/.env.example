# ==============================================================================
# 🐳 Docker Compose & Service Environment Variables (.env)
# ==============================================================================
# 이 파일은 Docker 컨테이너 실행 및 docker-compose 구동을 위한 환경 변수 파일입니다.
#
# [프로젝트 소스 내 위치 안내 (빌드/패키징 시 자동 오버레이)]
# - docker.profiles/{profile}/.env-{profile} (또는 .env)
#
# [배포 패키지 내 위치]
# - 배포 패키지 루트 디렉토리의 .env (docker-compose.yml과 동일 위치)
# ==============================================================================

# 컨테이너 실행 유저 및 그룹 UID/GID
APP_UID=1000
APP_GID=1000

# 서비스 및 이미지 명칭
APP_NAME=@appName@
DOCKER_IMAGE=@dockerImage@

# 외부 서비스 포트 (호스트 리스닝 포트)
HTTP_PORT=@httpPort@

# 호스트 로그 및 설치 경로
LOG_PATH=./log
DEST_DIR=.

# 컨테이너 내부 서비스 로그 경로
CONTAINER_LOG_PATH=/log
