# ==============================================================================
# 🚀 Spring Boot 서비스 런타임 환경 설정 (.env)
# ==============================================================================
# 이 파일은 Legacy(일반 서버) 및 Docker 환경에서 애플리케이션 실행 옵션을
# 스크립트(start.sh) 수정 없이 동적으로 주입하기 위해 사용됩니다.
#
# [적용 위치 안내]
# 1. 패키지 루트 디렉토리: .env (Docker Compose와 공용 사용 시 권장)
# 2. config 디렉토리:      config/.env
# 3. bin 디렉토리:         bin/.env
#
# * 파일 단위 @Override: 프로젝트 내 scripts/service/.env (또는 scripts/{env}/.env)를
#   생성해두면 빌드 시 자동으로 패키지 내에 포함됩니다.
# ==============================================================================

# ------------------------------------------------------------------------------
# ☕ 1. JVM 힙 메모리 및 실행 옵션
# ------------------------------------------------------------------------------
# 초기 힙 메모리 (기본값: 미지정 - JVM 기본값)
JVM_XMS="-Xms1024m"

# 최대 힙 메모리 (기본값: 미지정 - JVM 기본값)
JVM_XMX="-Xmx2048m"

# 추가 JVM 옵션 (GC 튜닝, 인코딩, 타임존, 시스템 프로퍼티 등)
EXTRA_JAVA_OPTS="-XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Seoul"

# ------------------------------------------------------------------------------
# 🍃 2. Spring Boot 애플리케이션 파라미터 (Program Arguments)
# ------------------------------------------------------------------------------
# java -jar ... "$JAR_FILE" 뒤에 전달될 프로그램 인수 (공백으로 구분)
# 예시:
#   --server.port=8080
#   --spring.profiles.active=prod
#   --logging.level.root=INFO
#   --custom.feature.enabled=true
APP_ARGS=""

# ------------------------------------------------------------------------------
# 🌐 3. 네트워크 및 프로세스 관리 설정
# ------------------------------------------------------------------------------
# 서비스 리스닝 포트 (미지정 시 config/application.yml의 port를 자동 파싱)
SERVER_PORT=8080

# 로그 파일 저장 기본 디렉토리 (기본값: {PROJECT_ROOT}/log)
LOG_PATH=""

# 프로세스 ID(PID) 저장 파일 경로 (기본값: {SCRIPT_DIR}/application.pid)
PID_FILE=""

# 서비스 정상 종료(Graceful Shutdown) 대기 시간 (단위: 초, 기본값: 10)
STOP_TIMEOUT=15

# ------------------------------------------------------------------------------
# 🐳 4. Docker / 컨테이너 환경 설정 (Docker Compose 공용 가능)
# ------------------------------------------------------------------------------
# 컨테이너 내부 실행 사용자 및 그룹 ID (기본값: 1000)
APP_UID=1000
APP_GID=1000

# 컨테이너 기동 시 권한을 동적으로 부여할 볼륨 마운트 디렉토리 목록 (공백 구분)
CHOWN_DIRS="/var/log /app/config"

# 컨테이너 타임존
TZ="Asia/Seoul"
