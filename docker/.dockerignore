# ==============================================================================
# 🐳 Docker 빌드 컨텍스트 제외 설정 (.dockerignore)
# ==============================================================================
# Windows 배치 파일 (컨테이너 내부는 Linux 환경이므로 제외)
**/*.bat
**/*.cmd

# 배포 및 아카이브 파일
deploy/
*.tar
*.zip
*.log

# Git 및 IDE 설정
.git/
.gitignore
.idea/
.vscode/
